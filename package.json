{
  "name": "ethereal-x-root",
  "version": "1.0.0",
  "description": "Ethereal X - Plataforma de Streaming (TCC 2026)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"backend,frontend\" -c \"magenta,cyan\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
