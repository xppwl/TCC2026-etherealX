# Configurações do Servidor
PORT=3000

# Banco de Dados Neon DB (PostgreSQL na Nuvem)
DATABASE_URL=postgresql://usuario:senha@ep-...neon.tech/etherealstreamingdb?sslmode=require

# Banco de Dados MySQL (Fallback local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=ethereal_streaming

# Autenticação e Sessão
JWT_SECRET=seu_jwt_secret_aqui
SESSION_SECRET=seu_session_secret_aqui

# Google OAuth 2.0 (Opcional)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Envio de E-mails (SMTP Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_16_digitos
EMAIL_FROM="Ethereal X <seu_email@gmail.com>"

